# URL del servidor de licencias (FastAPI, puerto 8000)
# Por defecto: http://localhost:8000
VITE_LICENSE_API_URL=http://localhost:8000

# Notas:
# - El servidor OBD2 (Flask) está configurado en vite.config.js (/api proxy a localhost:5000)
# - Cambiar VITE_LICENSE_API_URL si el servidor de licencias está en otra máquina/puerto
